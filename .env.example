# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 可选：默认 deepseek-v4-flash（快、适合学习）
# 也可用 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# 你本地的天气服务
WEATHER_API_URL=http://localhost:8080/weather

# PostgreSQL（sessions + messages）
# 格式：postgresql://用户:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/server

# v0.3 循环护栏（可选）
# AGENT_MAX_STEPS=8
# AGENT_MAX_CONSECUTIVE_TOOL_ERRORS=3
# AGENT_LLM_TIMEOUT_SECONDS=60
# 天气 GET 总尝试次数（含第一次；读请求幂等才安全）
# AGENT_TOOL_MAX_ATTEMPTS=2
